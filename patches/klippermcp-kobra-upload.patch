+import { z } from "zod";
+import { promises as fs } from "node:fs";
+import path from "node:path";
+import { PrinterManager } from "../printerManager.js";
+import { MoonrakerError } from "../moonraker/errors.js";
+
+export const uploadGcodeFileSchema = {
+  printer: z.string().optional(),
+  localPath: z.string().min(1),
+  remoteFilename: z.string().min(1).optional(),
+};
+
+export type UploadGcodeFileParams = z.infer<
+  z.ZodObject<typeof uploadGcodeFileSchema>
+>;
+
+export async function uploadGcodeFile(
+  printerManager: PrinterManager,
+  params: UploadGcodeFileParams
+): Promise<{ content: Array<{ type: "text"; text: string }> }> {
+  try {
+    const source = path.resolve(params.localPath);
+
+    if (!path.isAbsolute(params.localPath)) {
+      throw new Error("localPath must be an absolute path");
+    }
+
+    if (path.extname(source).toLowerCase() !== ".gcode") {
+      throw new Error("localPath must point to a .gcode file");
+    }
+
+    const stat = await fs.stat(source);
+
+    if (!stat.isFile()) {
+      throw new Error(`Local path is not a file: ${source}`);
+    }
+
+    const filename = params.remoteFilename ?? path.basename(source);
+
+    if (
+      params.remoteFilename &&
+      (
+        params.remoteFilename !== path.basename(params.remoteFilename) ||
+        /[\\/]/.test(params.remoteFilename)
+      )
+    ) {
+      throw new Error(
+        "remoteFilename must be a plain filename without path components"
+      );
+    }
+
+    if (path.extname(filename).toLowerCase() !== ".gcode") {
+      throw new Error("remoteFilename must end with .gcode");
+    }
+
+    const client = printerManager.getClient(params.printer);
+
+    const files = await client.listGcodeFiles();
+    const existing = files.find((file) => file.path === filename);
+
+    if (existing) {
+      return {
+        content: [{
+          type: "text",
+          text: JSON.stringify({
+            uploaded: false,
+            conflict: true,
+            printer: client.printerName,
+            filename,
+            existingSize: existing.size,
+            message: "Datei existiert bereits. Kein Überschreiben.",
+          }, null, 2),
+        }],
+      };
+    }
+
+    const content = await fs.readFile(source, "utf8");
+
+    const result = await client.uploadFile(
+      "gcodes",
+      filename,
+      content
+    );
+
+    return {
+      content: [{
+        type: "text",
+        text: JSON.stringify({
+          uploaded: true,
+          printer: client.printerName,
+          localPath: source,
+          filename,
+          size: stat.size,
+          result,
+          message: "G-Code hochgeladen. Kein Druck wurde gestartet.",
+        }, null, 2),
+      }],
+    };
+  } catch (error) {
+    if (error instanceof MoonrakerError) {
+      return {
+        content: [{
+          type: "text",
+          text: JSON.stringify({
+            error: true,
+            message: error.toUserMessage(),
+          }, null, 2),
+        }],
+      };
+    }
+
+    if (error instanceof Error) {
+      return {
+        content: [{
+          type: "text",
+          text: JSON.stringify({
+            error: true,
+            message: error.message,
+          }, null, 2),
+        }],
+      };
+    }
+
+    return {
+      content: [{
+        type: "text",
+        text: JSON.stringify({
+          error: true,
+          message: "Unerwarteter Fehler",
+          details: String(error),
+        }, null, 2),
+      }],
+    };
+  }
+}
