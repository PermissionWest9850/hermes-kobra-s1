# Hermes Kobra S1 profile environment
# Copy to .env during installation. Do not commit a real .env file.

# Moonraker URL exposed by Rinkhals on the Kobra S1.
# Examples:
# KOBRA_S1_MOONRAKER_URL=http://PRINTER_IP:7125
KOBRA_S1_MOONRAKER_URL=

# Local KlipperMCP checkout installed by install.sh.
KLIPPER_MCP_PATH=

# Persistent local 3D-print workspace.
PROJECT_DIR=

# Tool paths installed or detected by install.sh.
FREECADCMD_PATH=/usr/bin/freecadcmd
ORCA_SLICER_PATH=/opt/orcaslicer/OrcaSlicer.AppImage
ORCA_PROFILE_ROOT=/opt/orcaslicer/squashfs-root/resources/profiles/Anycubic

# Optional profile overrides. Leave empty for the generated local project profiles.
KOBRA_MACHINE_PROFILE=
KOBRA_PROCESS_PROFILE=
KOBRA_FILAMENT_PROFILE=
